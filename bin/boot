#!/usr/bin/env ruby
require_relative "../lib/campfire/deployment"
require_relative "../lib/campfire/process_supervisor"

Dir.chdir(File.expand_path("..", __dir__))
abort "Production boot must run as the unprivileged application user" if Process.uid.zero?

begin
  deployment = Campfire::Deployment.new.apply!
  deployment.check_storage!(Dir.pwd)
  FileUtils.mkdir_p("tmp/pids")
  File.unlink("tmp/pids/server.pid") if File.exist?("tmp/pids/server.pid")
  commands = YAML.safe_load_file("Procfile")
  exit Campfire::ProcessSupervisor.new(
    commands: commands,
    prepare: [ "bin/rails", "db:prepare" ],
    after_prepare: [ "bin/rails", "runner", "Campfire::Bootstrap.check_startup!; AgentNative::Maintenance.startup!" ]
  ).run
rescue Campfire::Deployment::Invalid => error
  abort "Campfire preflight failed: #{error.message}"
end
