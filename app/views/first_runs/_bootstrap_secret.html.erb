<% if Campfire::Bootstrap.required? %>
  <div class="flex flex-column gap">
    <%= label_tag :bootstrap_secret, "Instance setup secret" %>
    <%= password_field_tag :bootstrap_secret, nil, required: true, minlength: 32,
          maxlength: 4096, autocomplete: "off", class: "input",
          aria: { describedby: "bootstrap-secret-help" } %>
    <p id="bootstrap-secret-help">Enter the setup secret from your private deployment configuration. It is only used for the first administrator.</p>
  </div>
<% end %>
