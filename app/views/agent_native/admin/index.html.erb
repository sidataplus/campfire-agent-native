<% @page_title = "Manage integrations" %><% content_for :nav do %><%= link_to "Workspace", "/agent/workspace" %><% end %>
<section class="agent-workspace"><h1>Manage integrations</h1><p>Room access, instruction authority and token scopes are independent. New room grants start at the time of the grant.</p>
<% @profiles.each do |profile| %><article class="agent-card"><h2><%= profile.user.name %></h2><p><%= profile.enabled ? "Enabled" : "Disabled" %> · <code><%= profile.id %></code></p>
  <h3>Room grants</h3><% profile.room_grants.each do |grant| %><p><%= grant.room.name %><%= button_to "Revoke room", "/agent/admin/#{profile.id}", params: {operation: "revoke_room", grant_id: grant.id}, class: "btn" %></p><% end %>
  <%= form_with url: "/agent/admin/#{profile.id}", class: "agent-form" do |form| %><%= hidden_field_tag :operation, "grant_room" %><%= form.label :room_id, "Add room access" %><%= form.select :room_id, @rooms.map { |r| [r.name.presence || "Direct conversation", r.id] } %><%= form.submit "Grant room", class: "btn" %><% end %>
  <h3>Human operators</h3><% profile.operator_grants.each do |grant| %><p><%= grant.user.name %><%= button_to "Revoke operator", "/agent/admin/#{profile.id}", params: {operation: "revoke_operator", grant_id: grant.id}, class: "btn" %></p><% end %>
  <%= form_with url: "/agent/admin/#{profile.id}", class: "agent-form" do |form| %><%= hidden_field_tag :operation, "grant_operator" %><%= form.label :user_id, "Human allowed to instruct" %><%= form.select :user_id, @humans.map { |u| [u.name, u.id] } %><%= form.submit "Grant operator", class: "btn" %><% end %>
  <h3>Credentials</h3><% profile.credentials.each do |credential| %><p><code><%= credential.id %></code> · <%= credential.usable? ? "usable" : "expired/revoked" %> · last used <%= credential.last_used_at || "never" %><%= button_to "Revoke token", "/agent/admin/#{profile.id}", params: {operation: "revoke_token", credential_id: credential.id}, class: "btn" %></p><% end %>
  <% if profile.enabled %><%= form_with url: "/agent/admin/#{profile.id}", data: {turbo: false}, class: "agent-form" do |form| %><%= hidden_field_tag :operation, "issue_token" %><fieldset><legend>Scopes for a new 90-day token</legend><% profile.manifest.fetch("requested_scopes").each do |scope| %><label><%= check_box_tag "scopes[]", scope %> <%= scope %></label><br><% end %></fieldset><%= form.submit "Issue token once", class: "btn" %><% end %><%= button_to "Disable integration and revoke all tokens", "/agent/admin/#{profile.id}", params: {operation: "disable"}, class: "btn" %><% end %>
</article><% end %>
<h2>Register an integration</h2><p>Review the manifest's modes, capabilities, requested scopes and action types before registration. Nothing receives room access automatically.</p>
<%= form_with url: "/agent/admin", class: "agent-form" do |form| %><%= form.label :manifest, "IntegrationManifest JSON" %><%= form.text_area :manifest, rows: 16, required: true, maxlength: 32000 %><%= form.submit "Register integration", class: "btn" %><% end %>
</section>
