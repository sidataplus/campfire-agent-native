# Copy to .env for Docker Compose. Never commit the populated file.
# Generate independent random values; keep them unchanged across normal redeploys.
CAMPFIRE_PUBLIC_URL=https://chat.example.org
CAMPFIRE_PROXY_MODE=external
SECRET_KEY_BASE=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CAMPFIRE_RECOVERY_EPOCH=
# Required for a fresh database. Remove after the first administrator exists.
CAMPFIRE_BOOTSTRAP_SECRET=

# WP01 cannot enable native agents or dispatch.
CAMPFIRE_AGENT_ENABLED=false
CAMPFIRE_AGENT_DISPATCH_ENABLED=false
SKIP_TELEMETRY=true
PORT=8080
CAMPFIRE_PUMA_PORT=3001
WEB_CONCURRENCY=1
JOB_CONCURRENCY=1
# Do not set DISABLE_SSL, TLS_DOMAIN, THRUSTER_TLS_DOMAIN or DATABASE_URL.
